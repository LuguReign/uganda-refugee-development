    name == "nearest_exposure_plus_20"~"Nearest + 20km",
    name == "nearest_exposure_plus_50"~"Nearest + 50km"
    ),
    name = fct_relevel(name, "Nearest", "Nearest + 20km", "Nearest + 50km")
  ) %>%
  ggplot(aes(value)) + 
  geom_density() + 
  facet_grid(name~year, scales = "free") + 
  theme_bw()


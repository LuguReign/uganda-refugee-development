refsites_mungula = refsites_mungula %>% 
  mutate(Name_setlm = "Mungula II", District = "Adjumani", Sqkm = 10.279261) %>%
  dplyr::select(District, Name_setlm, Sqkm, geometry)

## Clean up refsites names
